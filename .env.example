# Anthropic API key — required for Haiku router + Sonnet synthesis
ANTHROPIC_API_KEY=sk-ant-...

# Langfuse self-hosted credentials (bootstrap project)
# Generate any random strings here; they must match between the api and langfuse services
LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
LANGFUSE_SECRET_KEY=sk-lf-local-dev
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
LANGFUSE_SALT=replace-with-openssl-rand-base64-32
LANGFUSE_USER_EMAIL=admin@example.com
LANGFUSE_USER_PASSWORD=changeme

# Optional port overrides
API_PORT=8000
QDRANT_PORT=6333
LANGFUSE_PORT=3000
